        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에 다시 설치해도 복원할 수 있습니다. 구매 내역은 Apple ID에 남습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt lại trên bất kỳ thiết bị nào — giao dịch mua được lưu theo Apple ID của bạn."
